# SAT-TRIAGE Environment Configuration
# Copy this file to .env and adjust values for your local environment.

# Backend API
API_HOST=0.0.0.0
API_PORT=8000
APP_NAME=SAT-TRIAGE API
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL Database
POSTGRES_USER=sat_triage
POSTGRES_PASSWORD=sat_triage_dev
POSTGRES_DB=sat_triage
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://sat_triage:sat_triage_dev@localhost:5433/sat_triage

# Security
JWT_SECRET_KEY=replace-with-a-secure-64-char-random-secret-key
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000

# Phase 6: Evidence-Linked RAG & AI Copilot
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
RUNBOOKS_DIR=backend/data/runbooks
FAISS_INDEX_DIR=backend/data/faiss
EMBEDDING_CACHE_DIR=backend/data/models
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.56

# LLM Provider Configuration (optional; if unset, retrieval remains active and generation reports unavailable)
# Supported LLM_PROVIDER values: auto, gemini, openai, openai_compatible
LLM_PROVIDER=auto
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=25.0
